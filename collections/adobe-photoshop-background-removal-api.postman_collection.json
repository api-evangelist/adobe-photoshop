                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"image\": {\n    \"source\": {\n      \"url\": \"<string>\"\n    }\n  },\n  \"output\": {\n    \"mediaType\": \"<string>\"\n  },\n  \"mode\": \"cutout\",\n  \"trim\": false,\n  \"backgroundColor\": {\n    \"red\": \"<integer>\",\n    \"green\": \"<integer>\",\n    \"blue\": \"<integer>\",\n    \"alpha\": \"<number>\"\n  },\n  \"colorDecontamination\": \"<integer>\"\n}",
